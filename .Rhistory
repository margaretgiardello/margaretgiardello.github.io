allNPS <- read_csv("actions_under_antiquities_act.csv") %>%
mutate(Type = str_extract(current_name, "National.*"))
unique(allNPS$Type)
establishedNM <- allNPS %>%
filter(Type %in% c("National Monument",
"National Monument and Preserve",
"National Monument & Preserve"),
action %in% c("Established",
"Established (FWS and NOAA)",
"Established (BLM)")) %>%
mutate(President = as.factor(str_extract(pres_or_congress, "\\w+$")),
#extract president last names only, then deal with 2 Roosevelts and Bush
President = case_when(
pres_or_congress == "T. Roosevelt" ~ "T. Roosevelt",
pres_or_congress == "F. D. Roosevelt" ~ "F. Roosevelt",
pres_or_congress == "G. W. Bush" ~ "G.W. Bush",
.default = President),
Size = as.numeric( #convert to number
str_extract( #extract only the numbers, including decimals
str_remove_all(acres_affected, ","), #remove commas
"\\d+\\.?\\d*")),
Units = if_else( #split the units into their own column
str_detect(acres_affected, regex("miles", ignore_case = TRUE)),
"sq mi", "acres"),
Color = case_when(
Size > 100000 & Units == "acres" ~ "orange",
Size <= 100000 & Units == "acres" ~ "gray",
Units == "sq mi" ~ "blue")
)
establishedNM$Color <- factor(establishedNM$Color, levels = c("orange","blue","gray"))
View(establishedNM)
ggplot(establishedNM, aes(President)) + geom_bar() + coord_flip()
View(establishedNM)
